# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env and edit.  NEVER put real broker credentials in this file —
# those belong in the macOS Keychain (see docs/setup-local-mac.md §6).
# .env is git-ignored; .env.example is not.
# ─────────────────────────────────────────────────────────────────────────────

# Trading mode. RESEARCH | BACKTEST | PAPER | LIVE
# LIVE is not implemented in Phase 1 and will refuse to start.
TRADING_MODE=RESEARCH

# Which market this instance is configured for. INDIA | US
TRADING_MARKET=INDIA

# Reporting currency for the portfolio. INR | USD
TRADING_BASE_CURRENCY=INR

# Starting capital for simulated runs, in base currency units.
TRADING_STARTING_CAPITAL=400000

# Event store. Leave unset to use a local JSONL file (no Docker needed).
# For Postgres via docker-compose:
#   TRADING_DATABASE_URL=postgresql+psycopg://trading:trading@localhost:5433/trading
# TRADING_DATABASE_URL=

# Where run artifacts are written.
TRADING_DATA_DIR=./data

# Logging. DEBUG | INFO | WARNING | ERROR   ·   console | json
TRADING_LOG_LEVEL=INFO
TRADING_LOG_FORMAT=console
