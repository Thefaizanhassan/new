# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key
credentials.json

# Data — large, regenerable, and often licence-restricted.
# Anchored to the repo root: a bare `data/` also matches src/trading/data/,
# which silently excluded the provider source from the first commit.
/data/
*.parquet
*.duckdb
*.db
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Notebooks
.ipynb_checkpoints/

# OS / editor
.DS_Store
.idea/
.vscode/

# Runtime
logs/
*.log
KILL
